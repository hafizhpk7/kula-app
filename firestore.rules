rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // PRIVATE MODE SWITCH. true  = only the allow-listed account(s) can touch data (current).
    //                      false = any signed-in account can (public mode).
    function isPrivateMode() {
      return false;
    }
    function isAllowedAccount() {
      return request.auth.token.email is string
        && (request.auth.token.email.lower() in ['keluargapuyoeci@growbang.app', 'kelpuci@growbang.app']
            || request.auth.token.email.lower().matches('.*@' + 'growbang.app$'));
    }
    function isSignedIn() {
      return request.auth != null && (!isPrivateMode() || isAllowedAccount());
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'updatedAt', 'familyId'])
        && data.id is string && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128))
        && (!('familyId' in data) || data.familyId == null || (data.familyId is string && data.familyId.size() <= 128));
    }

    function isValidUserAppState(data) {
      return data.keys().hasAll(['ownerId', 'schemaVersion', 'profiles'])
        && data.keys().hasOnly(['ownerId', 'schemaVersion', 'activeProfileId', 'profiles', 'paymentMode', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.schemaVersion is number
        && data.profiles is list && data.profiles.size() <= 100
        && (!('activeProfileId' in data) || (data.activeProfileId is string && data.activeProfileId.size() <= 128))
        && (!('paymentMode' in data) || (data.paymentMode in ['HYBRID', 'FULL_PRIVATE', 'FULL_BPJS']))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128));
    }

    function isValidFinanceTx(data) {
      return data.keys().hasAll(['id', 'ownerId', 'type', 'amount', 'categoryId', 'date', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'type', 'amount', 'categoryId', 'date', 'note', 'createdAt', 'updatedAt', 'walletId', 'createdBy'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.ownerId == request.auth.uid
        && data.type in ['income', 'expense']
        && data.amount is int && data.amount > 0 && data.amount <= 1000000000000
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 64
        && (!('walletId' in data) || (data.walletId is string && data.walletId.size() <= 64))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidFinanceConfig(data) {
      return data.keys().hasAll(['ownerId', 'schemaVersion', 'customCategories', 'budgets', 'includeVaccineCosts'])
        && data.keys().hasOnly(['ownerId', 'schemaVersion', 'customCategories', 'budgets', 'includeVaccineCosts', 'wallets', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && data.schemaVersion is number
        && data.customCategories is list && data.customCategories.size() <= 100
        && data.budgets is map && data.budgets.size() <= 200
        && data.includeVaccineCosts is bool
        && (!('wallets' in data) || (data.wallets is map && data.wallets.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSavingsGoal(data) {
      return data.keys().hasAll(['id', 'name', 'targetAmount', 'currentAmount'])
        && data.keys().hasOnly(['id', 'name', 'targetAmount', 'currentAmount', 'deadline', 'createdAt', 'updatedAt', 'createdBy'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.targetAmount is int && data.targetAmount > 0 && data.targetAmount <= 1000000000000
        && data.currentAmount is int && data.currentAmount >= 0 && data.currentAmount <= 1000000000000
        && (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    function isValidRecurringRule(data) {
      return data.keys().hasAll(['id', 'type', 'amount', 'categoryId', 'walletId', 'frequency'])
        && data.keys().hasOnly(['id', 'name', 'type', 'amount', 'categoryId', 'walletId', 'frequency', 'active', 'startDate', 'dayOfMonth', 'dayOfWeek', 'lastGeneratedThrough', 'createdAt', 'updatedAt', 'createdBy'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && data.type in ['income', 'expense']
        && data.amount is int && data.amount > 0 && data.amount <= 1000000000000
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 64
        && data.walletId is string && data.walletId.size() > 0 && data.walletId.size() <= 64
        && data.frequency in ['daily', 'weekly', 'monthly']
        && (!('active' in data) || data.active is bool)
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 64))
        && (!('dayOfMonth' in data) || (data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 31))
        && (!('dayOfWeek' in data) || (data.dayOfWeek is int && data.dayOfWeek >= 0 && data.dayOfWeek <= 6))
        && (!('lastGeneratedThrough' in data) || (data.lastGeneratedThrough is string && data.lastGeneratedThrough.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    // Test connection path (used by getDocFromServer healthcheck)
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);

      // User state and immunization records subcollection
      // Foto momen mode pribadi: hanya pemilik. Tidak pernah diubah, hanya dibuat dan dihapus.
      match /momenFoto/{fotoId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(fotoId)
          && isValidMomenFoto(incoming(), fotoId, true);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(fotoId);

        match /penuh/{docId} {
          allow get: if isOwner(userId) && isValidId(userId) && docId == 'data';
          allow list: if false;
          allow create: if isOwner(userId) && isValidId(userId) && docId == 'data'
            && isValidMomenFotoPenuh(incoming());
          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(userId) && docId == 'data';
        }
      }

      match /appData/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidUserAppState(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(docId) 
          && incoming().ownerId == existing().ownerId 
          && isValidUserAppState(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      match /financeTransactions/{txId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(txId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(txId)
          && isValidFinanceTx(incoming()) && incoming().id == txId;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(txId)
          && isValidFinanceTx(incoming()) && incoming().id == txId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(txId);
      }

      match /financeConfig/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && docId == 'main';
        allow list: if false;
        allow create, update: if isOwner(userId) && isValidId(userId) && docId == 'main'
          && isValidFinanceConfig(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && docId == 'main';
      }

      match /savingsGoals/{goalId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(goalId) && isValidSavingsGoal(incoming()) && incoming().id == goalId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(goalId);
      }

      match /recurringRules/{ruleId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(ruleId) && isValidRecurringRule(incoming()) && incoming().id == ruleId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(ruleId);
      }

      // Penunjuk keanggotaan: users/{uid}/membership/current (dipakai createFamily, joinFamily, dst.).
      match /membership/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && docId == 'current';
        allow list: if false;
        allow create: if isOwner(userId) && isValidId(userId) && docId == 'current'
          && isValidMembership(incoming(), userId)
          && existsAfter(memberPath(incoming().familyId, userId))
          && getAfter(memberPath(incoming().familyId, userId)).data.uid == userId;
        allow update: if false;
        allow delete: if isValidId(userId) && docId == 'current'
          && (isOwner(userId) || isFamilyAdmin(resource.data.familyId))
          && !existsAfter(memberPath(resource.data.familyId, userId));
      }
    }
    // ---------- Phase 2A: family helpers ----------
    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }
    function memberPath(fid, uid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(uid);
    }
    function membershipPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/membership/current;
    }
    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }
    function isFamilyMember(fid) {
      return isSignedIn() && isValidId(fid) && exists(memberPath(fid, request.auth.uid));
    }
    function isFamilyAdmin(fid) {
      return isFamilyMember(fid) && get(memberPath(fid, request.auth.uid)).data.role == 'admin';
    }
    function keyDiff() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isValidFamily(data, fid) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data.keys().hasOnly(['id', 'name', 'ownerId', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data.id == fid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.ownerId is string && isValidId(data.ownerId)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.schemaVersion is number;
    }

    function isValidMembership(data, uid) {
      return data.keys().hasAll(['uid', 'familyId', 'createdAt'])
        && data.keys().hasOnly(['uid', 'familyId', 'createdAt'])
        && data.uid == uid
        && data.familyId is string && isValidId(data.familyId)
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidMemberDoc(data, fid, uid) {
      return data.keys().hasAll(['uid', 'familyId', 'displayName', 'relation', 'role', 'isOwner', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'familyId', 'displayName', 'relation', 'role', 'isOwner', 'joinedAt', 'updatedAt', 'inviteCode'])
        && data.uid == uid && data.familyId == fid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80
        && data.relation in ['ayah', 'ibu', 'wali', 'kakek', 'nenek', 'saudara', 'pengasuh', 'lainnya']
        && data.role in ['admin', 'member']
        && data.isOwner is bool
        && data.joinedAt is string && data.joinedAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('inviteCode' in data) || (data.inviteCode is string && data.inviteCode.size() > 0 && data.inviteCode.size() <= 128));
    }

    function isValidInviteCreate(data, code) {
      return data.keys().hasAll(['code', 'familyId', 'familyName', 'createdBy', 'relation', 'role', 'createdAt', 'expiresAt', 'used'])
        && data.keys().hasOnly(['code', 'familyId', 'familyName', 'createdBy', 'relation', 'role', 'createdAt', 'expiresAt', 'used'])
        && data.code == code
        && data.familyId is string && isValidId(data.familyId)
        && data.familyName is string && data.familyName.size() > 0 && data.familyName.size() <= 80
        && data.createdBy == request.auth.uid
        && data.relation in ['ayah', 'ibu', 'wali', 'kakek', 'nenek', 'saudara', 'pengasuh', 'lainnya']
        && data.role in ['admin', 'member']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(3, 'd')
        && data.used == false;
    }

    function isValidJoinInvite(fid, memberData) {
      let code = memberData.inviteCode;
      let invBefore = get(invitePath(code)).data;
      let invAfter = getAfter(invitePath(code)).data;
      return invBefore.familyId == fid
        && invBefore.used == false
        && invBefore.expiresAt > request.time
        && invBefore.role == memberData.role
        && invBefore.relation == memberData.relation
        && invAfter.used == true
        && invAfter.usedBy == memberData.uid;
    }

    function isFamilyCreationMember(fid, uid) {
      return incoming().isOwner == true
        && incoming().role == 'admin'
        && !('inviteCode' in incoming())
        && !exists(familyPath(fid))
        && existsAfter(familyPath(fid))
        && getAfter(familyPath(fid)).data.ownerId == uid;
    }

    function isJoiningMember(fid) {
      return incoming().isOwner == false
        && 'inviteCode' in incoming()
        && isValidId(incoming().inviteCode)
        && exists(familyPath(fid))
        && isValidJoinInvite(fid, incoming());
    }

    function isSelfDisplayNameEdit(uid) {
      return request.auth.uid == uid
        && keyDiff().hasOnly(['displayName', 'updatedAt']);
    }

    function isAdminEditingOther(fid) {
      return keyDiff().hasOnly(['role', 'relation', 'updatedAt'])
        && existing().isOwner == false
        && isFamilyAdmin(fid);
    }

    function isOwnershipFlip(fid, uid) {
      let famBefore = get(familyPath(fid)).data;
      let famAfter = getAfter(familyPath(fid)).data;
      return keyDiff().hasOnly(['isOwner', 'role', 'updatedAt'])
        && incoming().role == 'admin'
        && incoming().isOwner != existing().isOwner
        && famBefore.ownerId == request.auth.uid
        && ((incoming().isOwner == true && famAfter.ownerId == uid)
            || (incoming().isOwner == false && famAfter.ownerId != uid));
    }

    function isOwnerTransfer(fid) {
      let newOwner = incoming().ownerId;
      return newOwner != request.auth.uid
        && exists(memberPath(fid, newOwner))
        && getAfter(memberPath(fid, newOwner)).data.isOwner == true
        && getAfter(memberPath(fid, newOwner)).data.role == 'admin'
        && getAfter(memberPath(fid, request.auth.uid)).data.isOwner == false;
    }

    function isValidFamilyFinanceTx(data, fid) {
      return data.keys().hasAll(['id', 'familyId', 'type', 'amount', 'categoryId', 'date', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['id', 'familyId', 'type', 'amount', 'categoryId', 'date', 'note', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'walletId'])
        && data.familyId == fid
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.type in ['income', 'expense']
        && data.amount is int && data.amount > 0 && data.amount <= 1000000000000
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 64
        && (!('walletId' in data) || (data.walletId is string && data.walletId.size() > 0 && data.walletId.size() <= 64))
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy == request.auth.uid;
    }

    function isValidFamilyFinanceConfig(data, fid) {
      return data.keys().hasAll(['familyId', 'schemaVersion', 'customCategories', 'budgets', 'includeVaccineCosts', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['familyId', 'schemaVersion', 'customCategories', 'budgets', 'includeVaccineCosts', 'updatedAt', 'updatedBy', 'wallets'])
        && data.familyId == fid
        && data.schemaVersion is number
        && data.customCategories is list && data.customCategories.size() <= 100
        && data.budgets is map && data.budgets.size() <= 200
        && data.includeVaccineCosts is bool
        && (!('wallets' in data) || (data.wallets is map && data.wallets.size() <= 50))
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.updatedBy == request.auth.uid;
    }

    // ---------- Bayi mode keluarga: families/{fid}/babies/** ----------
    // Mencerminkan persis yang ditulis FamilyBayiRepository (src/modules/bayi/repository).
    // Batas panjang sengaja longgar supaya tidak menolak data yang sah.
    function isValidFamilyBaby(data, babyId) {
      return data.keys().hasAll(['id', 'panggilan', 'tanggalLahir', 'insurance', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['id', 'panggilan', 'tanggalLahir', 'catatan', 'insurance', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'sourceUid', 'usiaKehamilanMinggu', 'jenisKelamin'])
        && data.id == babyId
        && data.panggilan is string && data.panggilan.size() > 0 && data.panggilan.size() <= 100
        && data.tanggalLahir is string && data.tanggalLahir.size() > 0 && data.tanggalLahir.size() <= 32
        && (!('catatan' in data) || (data.catatan is string && data.catatan.size() <= 2000))
        && data.insurance is map
        && data.schemaVersion is number
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy == request.auth.uid
        && (!('sourceUid' in data) || (data.sourceUid is string && data.sourceUid.size() <= 128))
        // Batas kewajaran teknis, bukan kriteria klinis (kriteria usia koreksi ada di konten aplikasi).
        && (!('usiaKehamilanMinggu' in data) || (data.usiaKehamilanMinggu is int && data.usiaKehamilanMinggu >= 0 && data.usiaKehamilanMinggu <= 60))
        && (!('jenisKelamin' in data) || data.jenisKelamin in ['L', 'P']);
    }

    function isValidFamilySchedule(data) {
      return data.keys().hasAll(['rows', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['rows', 'updatedAt', 'updatedBy'])
        && data.rows is list && data.rows.size() <= 300
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.updatedBy == request.auth.uid;
    }

    function isValidFamilyRecord(data, rowId) {
      return data.keys().hasAll(['rowId', 'diberikan', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['rowId', 'diberikan', 'tanggalDiberikan', 'tempat', 'merekBatch', 'biayaAktual', 'ditanggungAsuransi', 'nominalKlaim', 'statusKlaim', 'efekSamping', 'catatan', 'updatedAt', 'updatedBy'])
        && data.rowId == rowId
        && data.diberikan is bool
        && (!('tanggalDiberikan' in data) || (data.tanggalDiberikan is string && data.tanggalDiberikan.size() <= 32))
        && (!('tempat' in data) || data.tempat in ['Puskesmas', 'Posyandu', 'Rumah Sakit', 'Klinik', 'Dokter Praktik', 'Lainnya'])
        && (!('merekBatch' in data) || (data.merekBatch is string && data.merekBatch.size() <= 200))
        && (!('biayaAktual' in data) || (data.biayaAktual is int && data.biayaAktual >= 0 && data.biayaAktual <= 1000000000000))
        && (!('ditanggungAsuransi' in data) || data.ditanggungAsuransi is bool)
        && (!('nominalKlaim' in data) || (data.nominalKlaim is int && data.nominalKlaim >= 0 && data.nominalKlaim <= 1000000000000))
        && (!('statusKlaim' in data) || data.statusKlaim in ['Belum diajukan', 'Diajukan', 'Disetujui', 'Ditolak'])
        && (!('efekSamping' in data) || (data.efekSamping is string && data.efekSamping.size() <= 1000))
        && (!('catatan' in data) || (data.catatan is string && data.catatan.size() <= 1000))
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.updatedBy == request.auth.uid;
    }

    // ---------- Tumbuh kembang mode keluarga: babies/{babyId}/kpsp dan /milestone ----------
    // Mencerminkan persis yang ditulis FamilyBayiRepository (case setKpsp dan setMilestone).
    // Tidak memuat konstanta klinis (daftar umur formulir, ambang skor); hanya batas kewajaran teknis.
    function isValidFamilyKpsp(data, kpspId) {
      return data.keys().hasAll(['id', 'tanggal', 'umurFormulirBulan', 'jawaban', 'jumlahYa', 'hasil', 'versiKonten', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['id', 'tanggal', 'umurFormulirBulan', 'dikoreksi', 'jawaban', 'jumlahYa', 'hasil', 'versiKonten', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.id == kpspId
        && data.tanggal is string && data.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.umurFormulirBulan is int && data.umurFormulirBulan >= 1 && data.umurFormulirBulan <= 120
        && (!('dikoreksi' in data) || data.dikoreksi is bool)
        && data.jawaban is list && data.jawaban.size() <= 20
        && data.jumlahYa is int && data.jumlahYa >= 0 && data.jumlahYa <= 20
        && data.hasil in ['sesuai', 'meragukan', 'kemungkinanPenyimpangan']
        && data.versiKonten is string && data.versiKonten.size() > 0 && data.versiKonten.size() <= 64
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy == request.auth.uid;
    }

    function isValidFamilyMilestone(data, butirId) {
      return data.keys().hasAll(['butirId', 'status', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['butirId', 'status', 'tanggal', 'updatedAt', 'updatedBy'])
        && data.butirId == butirId
        && data.status in ['sudah', 'belum', 'belumYakin']
        && (!('tanggal' in data) || (data.tanggal is string && data.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.updatedBy == request.auth.uid;
    }

    // ---------- Pertumbuhan mode keluarga: babies/{babyId}/pengukuran ----------
    // Mencerminkan persis yang ditulis FamilyBayiRepository (case setPengukuran). Angka dicatat apa adanya
    // (koreksi cara ukur dan posisi dihitung di aplikasi); batasnya hanya kewajaran teknis, bukan kriteria klinis.
    function isValidFamilyPengukuran(data, pengukuranId) {
      return data.keys().hasAll(['id', 'tanggal', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['id', 'tanggal', 'beratKg', 'panjangTinggiCm', 'caraUkur', 'lingkarKepalaCm', 'catatan', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.id == pengukuranId
        && data.tanggal is string && data.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && ('beratKg' in data || 'panjangTinggiCm' in data || 'lingkarKepalaCm' in data)
        && (!('beratKg' in data) || (data.beratKg is number && data.beratKg > 0 && data.beratKg <= 300))
        && (!('panjangTinggiCm' in data) || (data.panjangTinggiCm is number && data.panjangTinggiCm > 0 && data.panjangTinggiCm <= 300))
        && (!('lingkarKepalaCm' in data) || (data.lingkarKepalaCm is number && data.lingkarKepalaCm > 0 && data.lingkarKepalaCm <= 150))
        && (!('caraUkur' in data) || data.caraUkur in ['berbaring', 'berdiri'])
        && (!('panjangTinggiCm' in data) || 'caraUkur' in data)
        && (!('catatan' in data) || (data.catatan is string && data.catatan.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy == request.auth.uid;
    }

    // ---------- Jurnal momen mode keluarga: babies/{babyId}/jurnal ----------
    // Mencerminkan FamilyBayiRepository.saveJurnal. Berbeda dari data Bayi lain, semua anggota boleh menulis;
    // izin per penulis ditegakkan di match di bawah. Foto ada di momenFoto; entri hanya menyimpan fotoIds.
    function isValidFamilyJurnal(data, jurnalId) {
      return data.keys().hasAll(['id', 'tanggal', 'judul', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['id', 'tanggal', 'judul', 'catatan', 'pertamaKali', 'milestoneId', 'fotoIds', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.id == jurnalId
        && data.tanggal is string && data.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.judul is string && data.judul.size() > 0 && data.judul.size() <= 100
        && (!('catatan' in data) || (data.catatan is string && data.catatan.size() <= 2000))
        && (!('pertamaKali' in data) || data.pertamaKali is bool)
        && (!('milestoneId' in data) || (data.milestoneId is string && data.milestoneId.size() > 0 && data.milestoneId.size() <= 64))
        && (!('fotoIds' in data) || isValidFotoIds(data.fotoIds))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy == request.auth.uid;
    }

    // ---------- Catatan makan MPASI mode keluarga: babies/{babyId}/makan (P1) ----------
    // Data kesehatan seperlunya: penanda reaksi tidak biasa berupa boolean, tanpa daftar gejala.
    function isValidFamilyMakan(data, makanId) {
      return data.keys().hasAll(['id', 'tanggal', 'bahan', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['id', 'tanggal', 'bahan', 'tekstur', 'porsi', 'reaksi', 'catatan', 'adaReaksiTidakBiasa',
                                'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.id == makanId
        && data.tanggal is string && data.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.bahan is list && data.bahan.size() >= 1 && data.bahan.size() <= 8
        && (!('tekstur' in data) || data.tekstur in ['lumat', 'cincang', 'keluarga'])
        && (!('porsi' in data) || (data.porsi is map && data.porsi.keys().hasAll(['jumlah', 'satuan'])
              && data.porsi.keys().hasOnly(['jumlah', 'satuan'])
              && data.porsi.jumlah is number && data.porsi.jumlah > 0 && data.porsi.jumlah <= 20
              && data.porsi.satuan in ['sdm', 'mangkok']))
        && (!('reaksi' in data) || data.reaksi in ['suka', 'biasa', 'kurangSuka'])
        && (!('catatan' in data) || (data.catatan is string && data.catatan.size() <= 300))
        && (!('adaReaksiTidakBiasa' in data) || data.adaReaksiTidakBiasa is bool)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy == request.auth.uid;
    }

    // ---------- Resep buatan pengguna mode keluarga: babies/{babyId}/resepSaya (P2) ----------
    // Rules tidak bisa memeriksa isi tiap elemen list: panjang teks bahan dan langkah dijaga klien, ukuran dokumen oleh Firestore.
    function isValidFamilyResepSaya(data, resepId) {
      return data.keys().hasAll(['id', 'judul', 'bahan', 'langkah', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['id', 'judul', 'umurMinBulan', 'bahan', 'langkah', 'catatan', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.id == resepId
        && data.judul is string && data.judul.size() > 0 && data.judul.size() <= 80
        && (!('umurMinBulan' in data) || (data.umurMinBulan is int && data.umurMinBulan >= 6 && data.umurMinBulan <= 23))
        && data.bahan is list && data.bahan.size() >= 1 && data.bahan.size() <= 20
        && data.langkah is list && data.langkah.size() >= 1 && data.langkah.size() <= 12
        && (!('catatan' in data) || (data.catatan is string && data.catatan.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy == request.auth.uid;
    }

    // ---------- Foto momen (R3b, D4): thumbnail di momenFoto/{id}, foto penuh di momenFoto/{id}/penuh/data ----------
    // Rules tidak bisa mengulang list, jadi tiap posisi (maks 3) dicek satu per satu.
    function isValidFotoIds(ids) {
      return ids is list && ids.size() <= 3
        && (ids.size() < 1 || isValidId(ids[0]))
        && (ids.size() < 2 || isValidId(ids[1]))
        && (ids.size() < 3 || isValidId(ids[2]));
    }
    // Dokumen thumbnail dan metadata. `babyId` hanya di mode pribadi (semua anak ada di satu akun).
    function isValidMomenFoto(data, fotoId, pribadi) {
      return data.keys().hasAll(['id', 'momenId', 'thumb', 'mime', 'lebar', 'tinggi', 'ukuran', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'momenId', 'babyId', 'thumb', 'mime', 'lebar', 'tinggi', 'ukuran', 'createdBy', 'createdAt'])
        && data.id == fotoId
        && isValidId(data.momenId)
        && (pribadi ? (data.babyId is string && isValidId(data.babyId)) : !('babyId' in data))
        && data.thumb is bytes && data.thumb.size() > 0 && data.thumb.size() <= 25600
        && data.mime in ['image/webp', 'image/jpeg']
        && data.lebar is int && data.lebar > 0 && data.lebar <= 2048
        && data.tinggi is int && data.tinggi > 0 && data.tinggi <= 2048
        && data.ukuran is int && data.ukuran > 0 && data.ukuran <= 256000
        && data.createdBy == request.auth.uid
        && data.createdAt is string && data.createdAt.size() <= 64;
    }
    // Dokumen foto penuh.
    function isValidMomenFotoPenuh(data) {
      return data.keys().hasAll(['foto', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['foto', 'createdBy', 'createdAt'])
        && data.foto is bytes && data.foto.size() > 0 && data.foto.size() <= 256000
        && data.createdBy == request.auth.uid
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // ---------- Stimulasi harian mode keluarga: babies/{babyId}/stimulasi ----------
    // Mencerminkan FamilyBayiRepository.saveStimulasi. Seperti jurnal, semua anggota boleh menulis;
    // id deterministik: c-<yyyy-MM-dd>-<aktivitasId> (dicoba) atau h-<aktivitasId> (sembunyi).
    function isValidFamilyStimulasi(data, stimulasiId) {
      return data.keys().hasAll(['id', 'aktivitasId', 'jenis', 'tanggal', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['id', 'aktivitasId', 'jenis', 'tanggal', 'reaksi', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.id == stimulasiId
        && data.aktivitasId is string && data.aktivitasId.matches('^[A-Za-z0-9_-]{1,64}$')
        && data.jenis in ['dicoba', 'sembunyi']
        && data.tanggal is string && data.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.jenis == 'dicoba'
              ? stimulasiId == 'c-' + data.tanggal + '-' + data.aktivitasId
              : stimulasiId == 'h-' + data.aktivitasId)
        && (!('reaksi' in data) || (data.jenis == 'dicoba' && data.reaksi in ['suka', 'biasa', 'kurangSuka']))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy == request.auth.uid;
    }

    // ---------- sibling of `match /users/{userId}` ----------
    match /invites/{code} {
      allow get: if isSignedIn() && isValidId(code);
      allow list: if isSignedIn() && isFamilyAdmin(resource.data.familyId);
      allow create: if isSignedIn() && isValidId(code)
        && isValidInviteCreate(incoming(), code)
        && isFamilyAdmin(incoming().familyId);
      allow update: if isSignedIn() && isValidId(code)
        && resource.data.used == false
        && request.time < resource.data.expiresAt
        && incoming().used == true
        && incoming().usedBy == request.auth.uid
        && incoming().usedAt is string && incoming().usedAt.size() <= 64
        && keyDiff().hasOnly(['used', 'usedBy', 'usedAt'])
        && !exists(memberPath(resource.data.familyId, request.auth.uid))
        && existsAfter(memberPath(resource.data.familyId, request.auth.uid));
      allow delete: if isSignedIn() && isFamilyAdmin(resource.data.familyId);
    }

    match /families/{familyId} {
      allow get: if isFamilyMember(familyId);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(familyId)
        && isValidFamily(incoming(), familyId)
        && incoming().ownerId == request.auth.uid
        && existsAfter(memberPath(familyId, request.auth.uid))
        && getAfter(memberPath(familyId, request.auth.uid)).data.isOwner == true
        && getAfter(memberPath(familyId, request.auth.uid)).data.role == 'admin'
        && existsAfter(membershipPath(request.auth.uid))
        && getAfter(membershipPath(request.auth.uid)).data.familyId == familyId;
      allow update: if isSignedIn() && isValidId(familyId)
        && resource.data.ownerId == request.auth.uid
        && isValidFamily(incoming(), familyId)
        && incoming().createdAt == existing().createdAt
        && (incoming().ownerId == existing().ownerId || isOwnerTransfer(familyId));
      allow delete: if isSignedIn() && isValidId(familyId)
        && resource.data.ownerId == request.auth.uid
        && !existsAfter(memberPath(familyId, request.auth.uid));

      match /members/{memberId} {
        allow get: if isSignedIn() && isValidId(familyId) && isValidId(memberId)
          && (request.auth.uid == memberId || isFamilyMember(familyId));
        allow list: if isFamilyMember(familyId);
        allow create: if isSignedIn() && isValidId(familyId) && isValidId(memberId)
          && memberId == request.auth.uid
          && isValidMemberDoc(incoming(), familyId, memberId)
          && existsAfter(membershipPath(memberId))
          && getAfter(membershipPath(memberId)).data.familyId == familyId
          && (isFamilyCreationMember(familyId, memberId) || isJoiningMember(familyId));
        allow update: if isSignedIn() && isValidId(familyId) && isValidId(memberId)
          && isValidMemberDoc(incoming(), familyId, memberId)
          && incoming().joinedAt == existing().joinedAt
          && (isSelfDisplayNameEdit(memberId)
              || isAdminEditingOther(familyId)
              || isOwnershipFlip(familyId, memberId));
        allow delete: if isSignedIn() && isValidId(familyId) && isValidId(memberId)
          && !existsAfter(membershipPath(memberId))
          && ((request.auth.uid == memberId && existing().isOwner == false)
              || (existing().isOwner == false && isFamilyAdmin(familyId))
              || (request.auth.uid == memberId && existing().isOwner == true
                  && !existsAfter(familyPath(familyId))));
      }

      match /financeTransactions/{txId} {
        allow get, list: if isFamilyMember(familyId);
        allow create: if isFamilyAdmin(familyId) && isValidId(txId)
          && isValidFamilyFinanceTx(incoming(), familyId) && incoming().id == txId;
        allow update: if isFamilyAdmin(familyId) && isValidId(txId)
          && isValidFamilyFinanceTx(incoming(), familyId) && incoming().id == txId
          && incoming().createdAt == existing().createdAt
          && incoming().createdBy == existing().createdBy;
        allow delete: if isFamilyAdmin(familyId) && isValidId(txId);
      }

      match /financeConfig/{docId} {
        allow get: if isFamilyMember(familyId) && docId == 'main';
        allow list: if false;
        allow create, update: if isFamilyAdmin(familyId) && docId == 'main'
          && isValidFamilyFinanceConfig(incoming(), familyId);
        allow delete: if isFamilyAdmin(familyId) && docId == 'main';
      }

      match /savingsGoals/{goalId} {
        allow get, list: if isFamilyMember(familyId);
        allow create, update: if isFamilyAdmin(familyId) && isValidId(goalId)
          && isValidSavingsGoal(incoming()) && incoming().id == goalId;
        allow delete: if isFamilyAdmin(familyId) && isValidId(goalId);
      }

      match /recurringRules/{ruleId} {
        allow get, list: if isFamilyMember(familyId);
        allow create, update: if isFamilyAdmin(familyId) && isValidId(ruleId)
          && isValidRecurringRule(incoming()) && incoming().id == ruleId;
        allow delete: if isFamilyAdmin(familyId) && isValidId(ruleId);
      }

      // Bayi mode keluarga: anggota membaca, hanya admin yang menulis (sama dengan finance*).
      match /babies/{babyId} {
        allow get, list: if isFamilyMember(familyId);
        allow create: if isFamilyAdmin(familyId) && isValidId(babyId)
          && isValidFamilyBaby(incoming(), babyId);
        allow update: if isFamilyAdmin(familyId) && isValidId(babyId)
          && isValidFamilyBaby(incoming(), babyId)
          && incoming().createdAt == existing().createdAt
          && incoming().createdBy == existing().createdBy;
        allow delete: if isFamilyAdmin(familyId) && isValidId(babyId);

        match /schedule/{docId} {
          allow get: if isFamilyMember(familyId) && docId == 'main';
          allow list: if false;
          allow create, update: if isFamilyAdmin(familyId) && docId == 'main'
            && isValidFamilySchedule(incoming());
          allow delete: if isFamilyAdmin(familyId) && docId == 'main';
        }

        match /records/{rowId} {
          allow get, list: if isFamilyMember(familyId);
          allow create, update: if isFamilyAdmin(familyId) && isValidId(rowId)
            && isValidFamilyRecord(incoming(), rowId);
          allow delete: if isFamilyAdmin(familyId) && isValidId(rowId);
        }

        // Hasil KPSP: anggota membaca, admin menulis; createdAt dan createdBy tidak boleh berubah.
        match /kpsp/{kpspId} {
          allow get, list: if isFamilyMember(familyId);
          allow create: if isFamilyAdmin(familyId) && isValidId(kpspId)
            && isValidFamilyKpsp(incoming(), kpspId);
          allow update: if isFamilyAdmin(familyId) && isValidId(kpspId)
            && isValidFamilyKpsp(incoming(), kpspId)
            && incoming().createdAt == existing().createdAt
            && incoming().createdBy == existing().createdBy;
          allow delete: if isFamilyAdmin(familyId) && isValidId(kpspId);
        }

        // Pengukuran pertumbuhan: anggota membaca, admin menulis; createdAt dan createdBy tidak boleh berubah.
        match /pengukuran/{pengukuranId} {
          allow get, list: if isFamilyMember(familyId);
          allow create: if isFamilyAdmin(familyId) && isValidId(pengukuranId)
            && isValidFamilyPengukuran(incoming(), pengukuranId);
          allow update: if isFamilyAdmin(familyId) && isValidId(pengukuranId)
            && isValidFamilyPengukuran(incoming(), pengukuranId)
            && incoming().createdAt == existing().createdAt
            && incoming().createdBy == existing().createdBy;
          allow delete: if isFamilyAdmin(familyId) && isValidId(pengukuranId);
        }

        // Jurnal momen: semua anggota membaca dan menambah (atas nama sendiri); hanya penulis mengubah;
        // penulis atau admin menghapus. createdAt dan createdBy tidak boleh berubah saat update.
        match /jurnal/{jurnalId} {
          allow get, list: if isFamilyMember(familyId);
          allow create: if isFamilyMember(familyId) && isValidId(jurnalId)
            && isValidFamilyJurnal(incoming(), jurnalId)
            && incoming().createdBy == request.auth.uid;
          allow update: if isFamilyMember(familyId) && isValidId(jurnalId)
            && isValidFamilyJurnal(incoming(), jurnalId)
            && existing().createdBy == request.auth.uid
            && incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt;
          allow delete: if isFamilyMember(familyId) && isValidId(jurnalId)
            && (existing().createdBy == request.auth.uid || isFamilyAdmin(familyId));
        }

        // Foto momen: anggota membaca; hanya penulis momen yang menambah foto ke momennya (dicek dengan
        // getAfter, jadi foto dan entri jurnal ditulis dalam satu batch); penulis foto atau admin menghapus.
        // Tidak ada update: foto hanya dibuat dan dihapus.
        match /momenFoto/{fotoId} {
          allow get, list: if isFamilyMember(familyId);
          allow create: if isFamilyMember(familyId) && isValidId(fotoId)
            && isValidMomenFoto(incoming(), fotoId, false)
            && getAfter(/databases/$(database)/documents/families/$(familyId)/babies/$(babyId)/jurnal/$(incoming().momenId)).data.createdBy == request.auth.uid;
          allow update: if false;
          allow delete: if isFamilyMember(familyId) && isValidId(fotoId)
            && (existing().createdBy == request.auth.uid || isFamilyAdmin(familyId));

          match /penuh/{docId} {
            allow get: if isFamilyMember(familyId) && docId == 'data';
            allow list: if false;
            allow create: if isFamilyMember(familyId) && docId == 'data'
              && isValidMomenFotoPenuh(incoming())
              && getAfter(/databases/$(database)/documents/families/$(familyId)/babies/$(babyId)/momenFoto/$(fotoId)).data.createdBy == request.auth.uid;
            allow update: if false;
            allow delete: if isFamilyMember(familyId) && docId == 'data'
              && (existing().createdBy == request.auth.uid || isFamilyAdmin(familyId));
          }
        }

        // Catatan makan MPASI: anggota membaca dan menambah atas nama sendiri; penulis mengubah; penulis atau admin menghapus.
        match /makan/{makanId} {
          allow get, list: if isFamilyMember(familyId);
          allow create: if isFamilyMember(familyId) && isValidId(makanId)
            && isValidFamilyMakan(incoming(), makanId)
            && incoming().createdBy == request.auth.uid;
          allow update: if isFamilyMember(familyId) && isValidId(makanId)
            && isValidFamilyMakan(incoming(), makanId)
            && existing().createdBy == request.auth.uid
            && incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt;
          allow delete: if isFamilyMember(familyId) && isValidId(makanId)
            && (existing().createdBy == request.auth.uid || isFamilyAdmin(familyId));
        }

        // Resep buatan pengguna: anggota membaca dan menambah atas nama sendiri; penulis mengubah; penulis atau admin menghapus.
        match /resepSaya/{resepId} {
          allow get, list: if isFamilyMember(familyId);
          allow create: if isFamilyMember(familyId) && isValidId(resepId)
            && isValidFamilyResepSaya(incoming(), resepId)
            && incoming().createdBy == request.auth.uid;
          allow update: if isFamilyMember(familyId) && isValidId(resepId)
            && isValidFamilyResepSaya(incoming(), resepId)
            && existing().createdBy == request.auth.uid
            && incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt;
          allow delete: if isFamilyMember(familyId) && isValidId(resepId)
            && (existing().createdBy == request.auth.uid || isFamilyAdmin(familyId));
        }

        // Stimulasi harian: semua anggota membaca dan menambah (atas nama sendiri); hanya penulis mengubah;
        // penulis atau admin menghapus. createdAt dan createdBy tidak boleh berubah saat update.
        match /stimulasi/{stimulasiId} {
          allow get, list: if isFamilyMember(familyId);
          allow create: if isFamilyMember(familyId) && isValidId(stimulasiId)
            && isValidFamilyStimulasi(incoming(), stimulasiId)
            && incoming().createdBy == request.auth.uid;
          allow update: if isFamilyMember(familyId) && isValidId(stimulasiId)
            && isValidFamilyStimulasi(incoming(), stimulasiId)
            && existing().createdBy == request.auth.uid
            && incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt;
          allow delete: if isFamilyMember(familyId) && isValidId(stimulasiId)
            && (existing().createdBy == request.auth.uid || isFamilyAdmin(familyId));
        }

        // Catatan milestone per butir (id dokumen = butirId).
        match /milestone/{butirId} {
          allow get, list: if isFamilyMember(familyId);
          allow create, update: if isFamilyAdmin(familyId) && isValidId(butirId)
            && isValidFamilyMilestone(incoming(), butirId);
          allow delete: if isFamilyAdmin(familyId) && isValidId(butirId);
        }
      }
    }

  }
}
